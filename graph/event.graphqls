type EventHttp {
    id: ID!
    createdAt: Timestamp!
    updatedAt: Timestamp!
    name: String!
    startDate: Timestamp!
    endDate: Timestamp!
}

type EventDetailsHttp {
    id: ID!
    createdAt: Timestamp!
    updatedAt: Timestamp!
    name: String!
    description: String!
    startDate: Timestamp!
    endDate: Timestamp!
}

input NewEvent {
    name: String!
    description: String!
    startDate: Timestamp!
    endDate: Timestamp!
}

input UpdateEvent {
    id: ID!
    name: String!
    description: String!
    startDate: Timestamp!
    endDate: Timestamp!
}

type EventHttpList {
    events: [EventHttp!]!
    countRows: Int!
}

extend type Mutation {
    CreateEvent(input: NewEvent!): EventDetailsHttp! @hasRole(roles: [SuperAdmin])
    UpdateEvent(input: UpdateEvent!): EventDetailsHttp! @hasRole(roles: [SuperAdmin])
}

extend type Query {
    GetEventById(id: ID!): EventDetailsHttp!
    GetAllEvents(page: Int, pageSize: Int): EventHttpList!
}